# Cicada Hunt Server — Default Configuration
# Override any of these with environment variables.

# Server
SERVER_PORT=8080
ENV=development

# Database (PostgreSQL + PostGIS)
# DATABASE_URL=postgres://cicada:cicada_dev@localhost:5432/cicada_hunt?sslmode=disable

# Redis
# REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Game Settings
MAX_DAILY_DIGS=50
MAX_NYMPHS_PER_CELL=50
MAX_QUERY_RADIUS_M=500
MAX_RESULTS_PER_QUERY=50

# Rate Limiting
RATE_LIMIT_PER_MIN=120

# External APIs (leave empty to use mock)
WEATHER_API_KEY=
WEATHER_BASE_URL=

# Cache TTLs
CELL_NYMPHS_TTL=10m
DENSITY_TTL=1h
COOLDOWN_TTL=5m
